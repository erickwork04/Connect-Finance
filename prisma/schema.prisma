// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ImportBatch {
  id                String            @id @default(uuid())
  userId            String
  fileName          String
  source            TransactionSource
  totalTransactions Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  transactions      Transaction[]

  @@index([userId, createdAt])
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  amount        Decimal                  @db.Decimal(10, 2)
  category      TransactionCategory
  paymentMethod TransactionPaymentMethod
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String
  source        TransactionSource?       @default(MANUAL)
  externalId    String?
  importHash    String?
  importBatchId String?
  importBatch   ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  commitment    MonthlyCommitment?

  @@index([userId, importHash])
  @@index([userId, date, amount])
  @@index([userId, importBatchId])
}

model CreditCard {
  id         String            @id @default(uuid())
  userId     String
  name       String
  brand      String
  limitTotal Decimal           @db.Decimal(12, 2)
  closingDay Int
  dueDay     Int
  isPrimary  Boolean           @default(false)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  invoices   CardInvoice[]
  installments InstallmentPlan[]

  @@index([userId, isActive, isPrimary])
}

model CardInvoice {
  id        String       @id @default(uuid())
  userId    String
  cardId    String
  month     String       @db.VarChar(7)
  amount    Decimal      @db.Decimal(12, 2)
  status    InvoiceStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  card      CreditCard   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([cardId, month])
  @@index([userId, month])
}

model InstallmentPlan {
  id                String            @id @default(uuid())
  userId            String
  description       String
  totalAmount       Decimal           @db.Decimal(12, 2)
  installmentAmount Decimal           @db.Decimal(12, 2)
  installmentCount  Int
  startMonth        String            @db.VarChar(7)
  cardId            String?
  status            InstallmentStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  card              CreditCard?       @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([userId, startMonth, status])
}

model MonthlyCommitment {
  id            String           @id @default(uuid())
  userId        String
  description   String
  amount        Decimal          @db.Decimal(12, 2)
  dueDate       DateTime
  category      TransactionCategory
  recurring     Boolean          @default(false)
  status        CommitmentStatus @default(PENDING)
  transactionId String?          @unique
  recurrenceId  String?
  occurrenceMonth String?        @db.VarChar(7)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  recurrence    RecurringCommitment? @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)

  @@index([userId, dueDate, status])
  @@unique([recurrenceId, occurrenceMonth])
}

model RecurringCommitment {
  id          String              @id @default(uuid())
  userId      String
  description String
  amount      Decimal             @db.Decimal(12, 2)
  category    TransactionCategory
  dueDay      Int
  startMonth  String              @db.VarChar(7)
  endMonth    String?             @db.VarChar(7)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  occurrences MonthlyCommitment[]

  @@index([userId, startMonth])
}

enum InvoiceStatus {
  OPEN
  PAID
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CommitmentStatus {
  PENDING
  CONFIRMED
  PAID
}

enum TransactionSource {
  MANUAL
  OFX
  CSV
  CARD_INVOICE
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  HOUSING
  TRANSPORTATION
  FOOD
  ENTERTAINMENT
  HEALTH
  SALARY
  EDUCATION
  OTHER
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}
