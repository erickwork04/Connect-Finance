# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance-ai?schema=public

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# AI Services
GEMINI_API_KEY=
# OPEN_API_KEY=
# OPENAI_API_KEY=

# Cakto Premium checkout (hosted offer URL and IDs from the Cakto panel)
CAKTO_PREMIUM_PRODUCT_ID=
CAKTO_PREMIUM_OFFER_ID=
CAKTO_PREMIUM_CHECKOUT_URL=

# Cakto webhook secret (used to validate X-Cakto-Signature)
CAKTO_WEBHOOK_SECRET=

# Background worker bearer token (configure the same value in the scheduler)
CRON_SECRET=

# App Configuration
APP_URL=http://localhost:3000
